# Copy this file to `.env` and fill in your real values.
# `.env` is git-ignored — never commit it.

# Notion integration token (starts with `secret_` or `ntn_`)
# Get one at: https://www.notion.so/profile/integrations
NOTION_TOKEN=<your-notion-token>

# The Notion page where you want databases to live.
# Open the page → Copy link → paste here.
NOTION_PAGE=<your-notion-page-url>

# WeRead API Key (starts with `wrk-`)
# Get one at: https://weread.qq.com/r/weread-skills
WEREAD_API_KEY=<your-weread-api-key>
